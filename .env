# Storage: set one. The server refuses to start with neither; MongoDB wins if both are set.
# MongoDB (the hosted site):
# MONGODB_URI=mongodb://localhost:27017
# MONGODB_DB=wcg
# Or a SQLite file (self-hosted; leave MONGODB_URI empty):
DATABASE_PATH=./data/wcg.db

# Optional with SQLite: generated on first start and kept beside the database.
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# Required in production: the address players use.
BETTER_AUTH_URL=http://localhost:3000

# Sign-in methods: each is on when its settings are, and production needs at least one.

# Optional: each provider is enabled only when both values are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Email links. In development without SMTP, links print to the server console;
# in production, email sign-in is off without both.
# Any SMTP provider, e.g. smtp://<login>:<smtp-key>@smtp-relay.brevo.com:587 (URL-encode @ in the login as %40)
SMTP_URL=
EMAIL_FROM=

# Username and password accounts (no email needed): set to 1.
AUTH_PASSWORD=
# Shortest password a new account may use (default 8).
AUTH_PASSWORD_MIN_LENGTH=

# Who may create an account. Open on MongoDB unless an invite code is set;
# with SQLite, closed unless SIGNUP_INVITE_CODE or SIGNUP_OPEN=1 is set.
SIGNUP_INVITE_CODE=
SIGNUP_OPEN=
